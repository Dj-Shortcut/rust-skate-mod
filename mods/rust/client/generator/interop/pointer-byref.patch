+    private static MethodSignature? MapCalleeSignature(RewriteGlobalContext context, RuntimeAssemblyReferences imports,
+        MethodSignature source)
+    {
+        var returnType = Pass80UnstripMethods.ResolveTypeInNewAssemblies(context, source.ReturnType, imports);
+        if (returnType == null)
+            return null;
