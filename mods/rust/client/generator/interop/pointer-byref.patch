+    private static int FindOwnMethod(TypeDefinition definition, TypeSignature owner, Utf8String? name,
+        MethodSignature expected, ModuleDefinition module, out MethodDefinition? match)
+    {
+        match = null;
+        var count = 0;
+        foreach (var candidate in definition.Methods)
+        {
+            if (candidate.Name != name || candidate.Signature == null)
+                continue;
+            var signature = candidate.Signature;
+            var effective = signature.InstantiateGenericTypes(
+                GetSignatureContext(owner, definition, signature.GenericParameterCount, module));
+            if (!SignatureComparer.Default.Equals(expected, effective))
+                continue;
+            if (candidate.GenericParameters.Count != signature.GenericParameterCount)
+                return 2; // A malformed definition is not a unique usable target.
+            match = candidate;
+            count++;
+        }
+        return count;
+    }
