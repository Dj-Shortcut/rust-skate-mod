+            GetSignatureContext(owner, definition, source.Signature.GenericParameterCount, module));
+        var rawMatches = FindOwnRawMethod(definition, source.Name, source.Signature,
+            SignatureComparer.Default, out declaration);
+        if (rawMatches != 0)
+            return rawMatches == 1;
+        var visited = new HashSet<TypeDefinition>(new CalleeTypeIdentityComparer());
+        while (TryGetOwnerDefinition(declarationOwner, out definition) && visited.Add(definition))
+        {
+            var matches = FindOwnMethod(definition, declarationOwner, source.Name, expected, module, out declaration);
+            if (matches != 0)
+                return matches == 1;
+            if (source.Name == ".ctor" || source.Name == ".cctor" || definition.IsInterface || definition.BaseType == null)
+                return false;
