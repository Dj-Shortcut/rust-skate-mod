+            if (candidate.Name != name || !comparer.Equals(expected, candidate.Signature))
+                continue;
+            if (candidate.GenericParameters.Count != candidate.Signature!.GenericParameterCount)
+                return 2;
+            match = candidate;
+            count++;
+        }
+        return count;
+    }
